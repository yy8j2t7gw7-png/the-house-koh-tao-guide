{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-house-koh-tao-guide",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6",
    "OPENAI_REASONING_EFFORT": "low",
    "PASSPORT_RETENTION_DAYS": "14"
  },
  "r2_buckets": [
    {
      "binding": "PASSPORT_UPLOADS",
      "bucket_name": "the-house-passport-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCIERGE_STORE",
        "class_name": "ConciergeStore"
      }
    ]
  },
  "exports": {
    "ConciergeStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "CONCIERGE_RATE_LIMITER",
      "namespace_id": "550001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 19 * * *"]
  }
}
